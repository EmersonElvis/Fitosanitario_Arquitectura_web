# Copie este archivo como .env y ajuste los valores. Nunca suba .env a GitHub.
PAPASALUD_BASE_DATOS_URL=postgresql+psycopg2://postgres:CAMBIAR_CLAVE@localhost:5432/papasalud
PAPASALUD_JWT_SECRETO=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
PAPASALUD_JWT_MINUTOS=480
PAPASALUD_UMBRAL_CERTEZA=0.70
PAPASALUD_MAX_MB_IMAGEN=8
# En producción: false y liste los orígenes permitidos (separados por comas)
PAPASALUD_CORS_PERMITIR_TODOS=true
PAPASALUD_CORS_ORIGENES_EXTRA=
